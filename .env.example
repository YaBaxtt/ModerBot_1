# Get this from @BotFather. Never commit the real value.
BOT_TOKEN=1234567890:replace_with_token_from_botfather
# asyncpg URL. Example: postgresql+asyncpg://moderbot:password@localhost:5432/moderbot
DATABASE_URL=postgresql+asyncpg://moderbot:password@localhost:5432/moderbot
# Comma-separated Telegram numeric IDs. These accounts receive reports, ads and purchases.
OWNER_IDS=5031299529,5031299530
LOG_LEVEL=INFO
# The third active warning always removes and bans the member until /unban.
# Anti-spam defaults: one normal message per second; five identical consecutive
# messages inside two minutes trigger a one-hour mute.
ANTISPAM_MIN_INTERVAL_SECONDS=1
ANTISPAM_REPEAT_LIMIT=5
ANTISPAM_REPEAT_WINDOW_SECONDS=120
ANTISPAM_MUTE_DURATION=1h
# New members must pass a verification question in this many seconds.
JOIN_VERIFICATION_TIMEOUT_SECONDS=60
# Permanent PRO access price for one group, in Telegram Stars (XTR).
PREMIUM_PRICE_STARS=50
# Optional HTTP health endpoint required by some web hosting platforms.
# Leave empty for a normal worker; many hosts inject PORT automatically.
PORT=8080
# Optional public links used by the main-menu Group and Channel buttons.
COMMUNITY_GROUP_URL=https://t.me/your_group
COMMUNITY_CHANNEL_URL=t.me/ton_ngl
